# Backend environment. Copy to `.env` for local use (or set in Render dashboard).

# Groq API key (free tier). The engine reads this from the environment and never
# hardcodes it. If unset, ambiguous records are escalated to the exception list
# rather than resolved — the batch still runs and reports honestly.
GROQ_API_KEY=

# Optional model overrides (defaults shown).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# CORS: your Vercel frontend origin, comma-separated, or * for dev.
ALLOWED_ORIGINS=*

# Where datasets are written/read. Defaults to backend/data locally.
DATA_DIR=./backend/data
